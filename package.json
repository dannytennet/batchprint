{
  "name": "batch-print",
  "productName": "Batch Print",
  "version": "0.1.0",
  "description": "Queue files into named print batches, tweak per-item settings and print them in order.",
  "main": "out/main/index.js",
  "author": "Danny Tennet",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
